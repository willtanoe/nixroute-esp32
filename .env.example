# Copy to .env and fill locally — NEVER commit .env with real values
# This file is committed as placeholder only.

# Wi-Fi (ESP32 station)
WIFI_SSID=
WIFI_PASSWORD=

# Local gateway auth (optional). When set, clients must send:
# Authorization: Bearer <LOCAL_API_TOKEN>
LOCAL_API_TOKEN=

# Upstream provider credentials (kept only on ESP32 NVS / build env)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults in firmware/sdkconfig.defaults)
UPSTREAM_TIMEOUT_MS=15000
MAX_BODY_BYTES=8192
HTTP_PORT=80
