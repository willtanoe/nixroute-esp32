# sdkconfig.defaults — ESP32-WROOM-32 AI API Router
# These override menuconfig without checking in generated sdkconfig.
# Measured impact: dynamic mbedTLS saves ~20KB per TLS session.

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Log — info default, cut verbose
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y

# Heap debugging optional (off by default to save RAM)
# CONFIG_HEAP_TRACING_STANDALONE is debug only
# CONFIG_HEAP_POISONING_DISABLED is default (save)

# Wi-Fi — trim buffers (serialize upstream, keep RAM)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# LWIP
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_REUSE_RXTOALL=y
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y

# mbedTLS — core memory saving (critical on WROOM-32, no PSRAM)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# HTTP Server — trim socket/header limits
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_MAX_OPEN_SOCKETS=4
CONFIG_HTTPD_MAX_URI_HANDLERS=10
CONFIG_HTTPD_CTRL_STACK_SIZE=6144
CONFIG_HTTPD_STACK_SIZE=6144

# HTTP Client — modest buffers, streaming
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_TLS_USING_MBEDTLS=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=n
CONFIG_PARTITION_TABLE_DEFAULT=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# Watchdog + stack canary
CONFIG_CHECK_STACK_CANARY=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
